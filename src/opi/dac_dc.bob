<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>DAC_DC$(MUUT):$(SITE)</name>
  <width>1190</width>
  <height>1160</height>
  <widget type="group" version="3.0.0">
    <name>DAC DC</name>
    <macros>
      <GAIN_AO424ELF>RANGE</GAIN_AO424ELF>
      <PREFIX_AO424ELF>0</PREFIX_AO424ELF>
      <GAIN_AO424ELF-LLC>RANGE</GAIN_AO424ELF-LLC>
      <PREFIX_AO424ELF-LLC>0</PREFIX_AO424ELF-LLC>
      <PREFIX>$(PREFIX_$(SITE_MODEL)=)</PREFIX>
      <GAIN>$(GAIN_$(SITE_MODEL)=AO:GAIN:CH)</GAIN>
    </macros>
    <x>10</x>
    <y>10</y>
    <width>1170</width>
    <height>1140</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>TITLE</name>
      <text>DAC DC CONTROL $(UUT):$(SITE) </text>
      <width>540</width>
      <height>30</height>
      <font>
        <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="group" version="3.0.0">
      <name>REFERENCE</name>
      <x>350</x>
      <y>60</y>
      <width>170</width>
      <height>30</height>
      <style>3</style>
      <transparent>true</transparent>
      <rules>
        <rule name="NO_REF" prop_id="visible" out_exp="true">
          <exp bool_exp="&quot;$(SITE_MODEL)&quot;.startswith(&quot;AO424&quot;)">
            <expression>false</expression>
          </exp>
          <exp bool_exp="true">
            <expression>true</expression>
          </exp>
          <pv_name>=abs(1)</pv_name>
        </rule>
      </rules>
      <widget type="combo" version="2.0.0">
        <name>Combo Box</name>
        <pv_name>${UUT}:${SITE}:AO:REF</pv_name>
        <x>80</x>
        <width>90</width>
      </widget>
      <widget type="label" version="2.0.0">
        <name>Label</name>
        <text>Reference</text>
        <width>70</width>
        <height>30</height>
        <font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </font>
        <horizontal_alignment>2</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
      </widget>
    </widget>
    <widget type="group" version="3.0.0">
      <name>SOURCE</name>
      <y>60</y>
      <width>170</width>
      <height>30</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="combo" version="2.0.0">
        <name>Combo Box_2</name>
        <pv_name>${UUT}:${SITE}:AWG:DIST</pv_name>
        <x>80</x>
        <width>90</width>
      </widget>
      <widget type="label" version="2.0.0">
        <name>Label_1</name>
        <text>Source</text>
        <width>70</width>
        <height>30</height>
        <font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </font>
        <horizontal_alignment>2</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
      </widget>
    </widget>
    <widget type="group" version="3.0.0">
      <name>TRIGGER</name>
      <x>170</x>
      <y>60</y>
      <width>170</width>
      <height>30</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="combo" version="2.0.0">
        <name>Combo Box_3</name>
        <pv_name>${UUT}:${SITE}:TRG</pv_name>
        <x>80</x>
        <width>90</width>
      </widget>
      <widget type="label" version="2.0.0">
        <name>Label_2</name>
        <text>Trigger</text>
        <width>70</width>
        <height>30</height>
        <font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </font>
        <horizontal_alignment>2</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
      </widget>
    </widget>
    <widget type="group" version="3.0.0">
      <name>DC SLIDER ALL</name>
      <y>110</y>
      <width>120</width>
      <height>330</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="group" version="3.0.0">
        <name>ALL BUTTONS</name>
        <y>250</y>
        <width>120</width>
        <height>80</height>
        <style>3</style>
        <background_color>
          <color red="230" green="230" blue="230">
          </color>
        </background_color>
        <rules>
          <rule name="HIDE_IF_AWG" prop_id="visible" out_exp="false">
            <exp bool_exp="pvStr0.upper() == 'AWG'">
              <value>false</value>
            </exp>
            <pv_name>${UUT}:${SITE}:AWG:DIST</pv_name>
          </rule>
        </rules>
        <widget type="group" version="3.0.0">
          <name>ALL BUTTONS INNER</name>
          <x>10</x>
          <width>100</width>
          <height>70</height>
          <style>3</style>
          <transparent>true</transparent>
          <widget type="action_button" version="3.0.0">
            <name>ZERO BUTTON</name>
            <actions>
              <action type="write_pv">
                <description>ZERO</description>
                <pv_name>${UUT}:${SITE}:AO:SLOW_SET:CH:ALL</pv_name>
                <value>0</value>
              </action>
            </actions>
            <font>
              <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
              </font>
            </font>
            <tooltip>$(actions)</tooltip>
          </widget>
          <widget type="action_button" version="3.0.0">
            <name>IDENT BUTTON</name>
            <actions>
              <action type="execute">
                <description>IDENT</description>
                <script file="../scripts/ident_dc.py">
                </script>
              </action>
            </actions>
            <pv_name>$(UUT):$(SITE):NCHAN</pv_name>
            <y>40</y>
            <font>
              <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
              </font>
            </font>
            <tooltip>$(actions)</tooltip>
          </widget>
        </widget>
      </widget>
      <widget type="group" version="3.0.0">
        <name>DC SLIDER</name>
        <macros>
          <id>ALL</id>
        </macros>
        <width>120</width>
        <height>250</height>
        <style>3</style>
        <background_color>
          <color red="230" green="230" blue="230">
          </color>
        </background_color>
        <rules>
          <rule name="HIDE_EMPTY" prop_id="visible" out_exp="true">
            <exp bool_exp="&quot;$(id)&quot;==&quot;ALL&quot;">
              <expression>true</expression>
            </exp>
            <exp bool_exp="pv0&gt;=int(&quot;$(id)&quot;)">
              <expression>true</expression>
            </exp>
            <exp bool_exp="true">
              <expression>false</expression>
            </exp>
            <pv_name>$(UUT):$(SITE):NCHAN</pv_name>
          </rule>
        </rules>
        <widget type="group" version="3.0.0">
          <name>DC SLIDER INNER</name>
          <x>10</x>
          <y>10</y>
          <width>100</width>
          <height>230</height>
          <style>3</style>
          <transparent>true</transparent>
          <widget type="label" version="2.0.0">
            <name>Label_3</name>
            <text>CH:$(id)</text>
            <font>
              <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
              </font>
            </font>
            <horizontal_alignment>1</horizontal_alignment>
            <vertical_alignment>1</vertical_alignment>
          </widget>
          <widget type="group" version="3.0.0">
            <name>SLIDER CENTER</name>
            <y>30</y>
            <width>100</width>
            <height>120</height>
            <style>3</style>
            <transparent>true</transparent>
          </widget>
          <widget type="combo" version="2.0.0">
            <name>Combo Box_1</name>
            <pv_name>${UUT}:${SITE}:$(GAIN):${id}</pv_name>
            <y>210</y>
            <height>20</height>
            <rules>
              <rule name="DISABLE_IF_XRM" prop_id="visible" out_exp="false">
                <exp bool_exp="$(id)=='all'">
                  <value>true</value>
                </exp>
                <exp bool_exp="pvStr0.upper().endswith(&quot;XRM&quot;)">
                  <value>false</value>
                </exp>
                <pv_name>${UUT}:${SITE}:PART_NUM</pv_name>
              </rule>
            </rules>
            <border_alarm_sensitive>$(SHOW_ALARM=1)</border_alarm_sensitive>
          </widget>
          <widget type="textupdate" version="2.0.0">
            <name>Text Update</name>
            <pv_name>${UUT}:${SITE}:AO:SLOW_SET:CH:${id}.RVAL</pv_name>
            <y>180</y>
            <horizontal_alignment>1</horizontal_alignment>
            <vertical_alignment>1</vertical_alignment>
            <border_alarm_sensitive>$(SHOW_ALARM=1)</border_alarm_sensitive>
          </widget>
          <widget type="group" version="3.0.0">
            <name>dc_inputs</name>
            <y>30</y>
            <width>100</width>
            <height>140</height>
            <style>3</style>
            <transparent>true</transparent>
            <widget type="spinner" version="2.0.0">
              <name>Spinner</name>
              <pv_name>${UUT}:${SITE}:AO:SLOW_SET:CH:${id}</pv_name>
              <y>120</y>
              <format>0</format>
              <precision>2</precision>
              <show_units>true</show_units>
              <background_color>
                <color name="Background" red="255" green="255" blue="255">
                </color>
              </background_color>
              <horizontal_alignment>1</horizontal_alignment>
              <vertical_alignment>1</vertical_alignment>
              <border_alarm_sensitive>$(SHOW_ALARM=1)</border_alarm_sensitive>
              <maximum>10.0</maximum>
            </widget>
            <widget type="scaledslider" version="2.0.0">
              <name>Scaled Slider_1</name>
              <pv_name>${UUT}:${SITE}:AO:SLOW_SET:CH:${id}</pv_name>
              <x>42</x>
              <width>58</width>
              <height>120</height>
              <horizontal>false</horizontal>
              <major_tick_step_hint>20</major_tick_step_hint>
              <border_alarm_sensitive>$(SHOW_ALARM=1)</border_alarm_sensitive>
            </widget>
            <widget type="rectangle" version="2.0.0">
              <name>COVER</name>
              <height>140</height>
              <visible>false</visible>
              <line_color>
                <color name="Transparent" red="255" green="255" blue="255" alpha="0">
                </color>
              </line_color>
              <background_color>
                <color red="210" green="210" blue="210" alpha="142">
                </color>
              </background_color>
              <rules>
                <rule name="DISABLE_WHEN_AWG_NOT_ALL" prop_id="visible" out_exp="false">
                  <exp bool_exp="pvStr0.upper() == 'AWG'">
                    <value>true</value>
                  </exp>
                  <pv_name>${UUT}:${SITE}:AWG:DIST</pv_name>
                </rule>
              </rules>
            </widget>
          </widget>
        </widget>
      </widget>
    </widget>
    <widget type="template" version="2.0.0">
      <name>DC SLIDER ARRAY</name>
      <file>components/dac_dc/dc_slider.bob</file>
      <instances>
        <instance>
          <macros>
            <id>$(PREFIX)1</id>
          </macros>
        </instance>
        <instance>
          <macros>
            <id>$(PREFIX)2</id>
          </macros>
        </instance>
