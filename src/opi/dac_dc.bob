      </instances>
      <x>140</x>
      <y>110</y>
      <width>1030</width>
      <height>1030</height>
      <horizontal>true</horizontal>
      <wrap_count>8</wrap_count>
      <transparent>true</transparent>
    </widget>
    <widget type="group" version="3.0.0">
      <name>DOC_LINK_1</name>
      <macros>
        <TARGET>14.1 SLOW AO (DC) OUTPUT</TARGET>
        <URL>${USER_GUIDE}#${TARGET}</URL>
      </macros>
      <x>540</x>
      <y>60</y>
      <width>25</width>
      <height>25</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="picture" version="2.0.0">
        <name>LINK_SYMBOL_1</name>
        <file>../images/doc_link.png</file>
        <width>25</width>
        <height>25</height>
      </widget>
      <widget type="action_button" version="3.0.0">
        <name>OPEN_LINK_BUTTON_1</name>
        <actions>
          <action type="open_webpage">
            <description>Open Web Page</description>
            <url>$(URL)</url>
          </action>
        </actions>
        <text></text>
        <width>25</width>
        <height>25</height>
        <transparent>true</transparent>
        <tooltip>$(URL)</tooltip>
        <border_alarm_sensitive>$(SHOW_ALARM=1)</border_alarm_sensitive>
      </widget>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>OPI MODEL</name>
      <pv_name>${UUT}:${SITE}:PART_NUM</pv_name>
      <y>30</y>
      <width>430</width>
      <height>30</height>
      <font>
        <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0">
        </font>
      </font>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <transparent>true</transparent>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="led" version="2.0.0">
      <name>LED_WARN_3</name>
      <pv_name>${UUT}:${SITE}:AWG:ARM</pv_name>
      <y>450</y>
      <off_color>
        <color red="153" green="77" blue="0">
        </color>
      </off_color>
      <on_color>
        <color name="MINOR" red="255" green="128" blue="0">
        </color>
      </on_color>
      <line_color>
        <color name="Text" red="0" green="0" blue="0">
        </color>
      </line_color>
      <square>true</square>
      <border_alarm_sensitive>$(SHOW_ALARM=1)</border_alarm_sensitive>
    </widget>
    <widget type="label" version="2.0.0">
      <name>LABEL_2</name>
      <text>Arm</text>
      <x>30</x>
      <y>450</y>
      <width>30</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Pulse Soft Button</name>
      <actions execute_as_one="true">
        <action type="write_pv">
          <description>PULSE SOFT TRG</description>
          <pv_name>${UUT}:SIG:SOFT_TRIGGER</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>PULSE SOFT TRG</text>
      <y>480</y>
      <width>120</width>
      <font>
        <font family="Liberation Sans" style="BOLD" size="12.0">
        </font>
      </font>
      <tooltip>$(actions)</tooltip>
    </widget>
  </widget>
</display>
